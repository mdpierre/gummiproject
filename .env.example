# Copy this file to .env and fill in values

# Server-side only — NEVER prefix with VITE_
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs (optional — only needed if VITE_TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_gummy_voice_id_here

# Server deployment config
# Add your deployed frontend origin(s) as a comma-separated list, e.g.
# ALLOWED_ORIGINS=https://gummy-demo.vercel.app
# If frontend and API are served from the same Render web service, this can stay blank.
ALLOWED_ORIGINS=

# Client-accessible (safe to expose)
# Local dev and a single Render web service can leave this blank.
# For a separate deployed API, set this to your backend URL.
VITE_API_BASE_URL=
VITE_TTS_PROVIDER=web-speech
